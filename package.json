{
  "name": "kosera-web-app",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "test -d .git && git config core.hooksPath .husky || true",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "hooks:setup": "git config core.hooksPath .husky && echo 'Husky hooks path set'",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx src/db/seed.ts",
    "db:seed-usm": "dotenv -e .env.local -- tsx src/db/seed-usm-complete.ts",
    "db:seed-mamikos": "dotenv -e .env.local -- tsx src/db/seed-mamikos.ts",
    "db:seed-photos": "dotenv -e .env.local -- tsx src/db/seed-photos.ts",
    "db:clear-photos": "dotenv -e .env.local -- tsx src/db/seed-photos.ts --clear",
    "db:drop": "dotenv -e .env.local -- drizzle-kit drop",
    "db:generate:prod": "dotenv -e .env.production -- drizzle-kit generate",
    "db:migrate:prod": "dotenv -e .env.production -- drizzle-kit migrate",
    "db:push:prod": "dotenv -e .env.production -- drizzle-kit push",
    "db:studio:prod": "dotenv -e .env.production -- drizzle-kit studio",
    "db:seed:prod": "dotenv -e .env.production -- tsx src/db/seed.ts",
    "db:drop:prod": "dotenv -e .env.production -- drizzle-kit drop",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "db:push:test": "dotenv -e .env.test -- drizzle-kit push",
    "db:seed:test": "dotenv -e .env.test -- tsx src/db/seed.ts",
    "ai:index": "tsx scripts/index-embeddings.ts",
    "cloudinary:test": "node scripts/test-cloudinary.js",
    "cloudinary:migrate": "node scripts/migrate-to-cloudinary.js",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:unit": "NODE_ENV=test SKIP_DB_RESET=1 vitest run tests/unit/",
    "test:integration": "NODE_ENV=test INTEGRATION_PERSIST=1 vitest run tests/integration/",
    "ci:test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration",
    "docker:test:setup": "docker compose --profile test up -d db_test && sleep 2",
    "docker:db:generate": "docker exec -it kosera-app npm run db:generate",
    "docker:db:migrate": "docker exec -it kosera-app npm run db:migrate",
    "docker:db:push": "docker exec -it kosera-app npm run db:push",
    "docker:db:push:test": "docker exec -it -e DATABASE_URL=postgresql://kosera:kosera123@db_test:5432/kosera_test kosera-app npx drizzle-kit push",
    "docker:db:migrate:test": "docker exec -it -e DATABASE_URL=postgresql://kosera:kosera123@db_test:5432/kosera_test kosera-app npx drizzle-kit migrate",
    "docker:db:studio": "docker exec -it kosera-app npm run db:studio",
    "docker:db:seed": "docker exec -it kosera-app npm run db:seed",
    "docker:db:seed-photos": "docker exec -it kosera-app npm run db:seed-photos",
    "docker:test": "docker exec -it -e NODE_ENV=test -e DATABASE_URL=postgresql://kosera:kosera123@db_test:5432/kosera_test kosera-app npm test",
    "docker:test:unit": "docker exec -it -e NODE_ENV=test -e SKIP_DB_RESET=1 -e DATABASE_URL=postgresql://kosera:kosera123@db_test:5432/kosera_test kosera-app npm run test:unit",
    "docker:test:integration": "docker exec -it -e NODE_ENV=test -e INTEGRATION_PERSIST=1 -e DATABASE_URL=postgresql://kosera:kosera123@db_test:5432/kosera_test kosera-app npm run test:integration",
    "docker:dev": "docker compose up",
    "docker:dev:detach": "docker compose up --build -d",
    "docker:dev:down": "docker compose down",
    "docker:dev:clean": "docker compose down -v --remove-orphans",
    "docker:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up --build",
    "docker:prod:detach": "docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "docker:logs": "docker logs kosera-app",
    "docker:logs:follow": "docker logs -f kosera-app",
    "docker:shell": "docker exec -it kosera-app /bin/sh",
    "docker:restart": "docker restart kosera-app",
    "docker:status": "docker ps --filter name=kosera"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-devtools": "^5.81.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "multer": "^2.0.2",
    "next": "^15.3.6",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "sweetalert2": "^11.22.2",
    "swiper": "^11.2.6",
    "swr": "^2.3.4",
    "zod": "^3.25.75"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/dotenv": "^6.1.1",
    "@types/leaflet": "^1.9.17",
    "@types/multer": "^2.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@types/swiper": "^5.4.3",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "eslint-config-prettier": "^10.1.2",
    "husky": "^9.0.0",
    "jsdom": "^26.1.0",
    "node-mocks-http": "^1.17.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.6",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
