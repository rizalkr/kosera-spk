# Kosera API - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# Frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database Configuration
# Use port 5434 when connecting to the Docker Compose db service from the host,
# or 5432 when connecting to a native PostgreSQL installation.
POSTGRES_DB=kosera
POSTGRES_USER=kosera
POSTGRES_PASSWORD=your-secure-password
DATABASE_URL=postgresql://kosera:your-secure-password@localhost:5434/kosera

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-64-char-string

# Application Configuration
NODE_ENV=development
PORT=3000

# Optional: pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@kosera.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Optional: Enable React Query DevTools in development
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# Cloudinary Configuration
# Sign up at https://cloudinary.com and get these from your dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Service Configuration (384-dim CPU Embedding Service for Semantic Search & SPK Hybrid)
# Local / Docker: http://localhost:8000
# Online / Cloud: https://YOUR_USERNAME-kosera-ai-service.hf.space
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=

# LLM Chat Inference Service (Fine-tuned Qwen2.5-7B-Instruct + QLoRA Assistant)
# Supported LLM_PROVIDER values:
#   - colab-fastapi     : Remote Colab Pro FastAPI SSE server via Cloudflare tunnel (Hybrid Mode)
#   - openai-compatible : Local Ollama (Offline Mode) or Remote vLLM GPU Server (Online Mode)
LLM_PROVIDER=colab-fastapi
LLM_SERVICE_URL=
LLM_MODEL_NAME=kosera-qwen2.5-7b
LLM_API_KEY=
CHAT_FEEDBACK_SALT=kosera-spk-sft-v2-salt